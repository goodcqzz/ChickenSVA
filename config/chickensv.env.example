# =============================================================================
# ChickenSV / ProjectAi3 唯一配置文件（API Key 与运行参数）
#
# 使用:
#   cp config/chickensv.env.example config/chickensv.env
#   chmod 600 config/chickensv.env
#   vim config/chickensv.env    # 填写下方 API Key
#
# 后端、MCP（systemd）、start.sh 均读取此文件。
# 勿提交 chickensv.env 到 Git；rsync 发布时不会覆盖安置机上的该文件。
# =============================================================================

# ---------- ① API Key（最常改，填这里即可）----------
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
PUBLIC_DEMO_API_KEY=

# ---------- ② 运行环境 ----------
# 安装根目录：留空自动推断（从仓库内启动时）；Docker 部署由 compose 注入，无需设置
#CHICKENSV_ROOT=/home/you/ChickenSVA
# Conda 环境名（开发机/安置机统一，默认 gaoai）
CHICKENSV_CONDA_ENV=gaoai

APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=9801
RELOAD=true

# ---------- ③ MCP / Dify ----------
# 端口块 9800=对外入口  9801=后端  9802=MCP（见 deploy/lib/ports.sh）
MCP_SERVER_URL=http://127.0.0.1:9802
MCP_HTTP_TIMEOUT_SECONDS=300
# 本机 Dify（Docker nginx 反代 80 → /v1）
DIFY_API_BASE=http://127.0.0.1/v1
DIFY_API_KEY=your-dify-api-key
DIFY_DEFAULT_SEARCH_METHOD=hybrid_search
DIFY_DEFAULT_TOP_K=5
DIFY_RERANKING_ENABLE=true
DIFY_SCORE_THRESHOLD_ENABLED=false
# 三个期刊知识库 dataset_id（默认值与代码一致，可按需覆盖）
# DIFY_DATASET_PARENT_QA=<your-dify-dataset-id>
# DIFY_DATASET_PURE_QA=<your-dify-dataset-id>
# DIFY_DATASET_ENGLISH_QA=<your-dify-dataset-id>

LLM_PROVIDER=deepseek
# 平台默认模型（当前平台选定 flash；pro 推理/边界判断更强，可按需切换）
DEEPSEEK_MODEL=deepseek-v4-flash
# 平台默认回答 max_tokens（deepseek-v4 系列上限 8192，避免长回答被截断而编造结尾）
PLATFORM_DEFAULT_MAX_TOKENS=8192
# 修改后端全局 LLM 配置（POST /api/v1/llm/config）的管理员令牌（请求头 X-Admin-Token）。
# 留空 = 该接口不写入全局配置（公网多用户默认，防止访客互相覆盖平台默认模型）
#LLM_CONFIG_ADMIN_TOKEN=

# ---------- ④ 公网 / 安全（安置机生产请改；setup-production 会自动写安全默认）----------
# 不持久化用户 Key（公网多用户务必 false；setup-production 会强制写 false）
PERSIST_USER_API_KEYS=false
PUBLIC_DEFAULT_MODEL_ENABLED=true
# 平台免费 Key 配额（仅限制后端提供的 Key；BYOK 不受限）
DEFAULT_MODEL_LIMITS_ENABLED=true
DEFAULT_MODEL_BURST_WINDOW_SECONDS=300
DEFAULT_MODEL_BURST_LIMIT=20
DEFAULT_MODEL_DAILY_QUOTA=200
# 通用 IP 限速（公网建议 true；setup-production 会强制写 true）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
# 反代跳数：用于从 X-Forwarded-For 解析真实客户端 IP，防伪造绕过限速。
# 本机 Nginx 之上还有 1 层高校外网反代 → 1（默认）；公网直达本机 Nginx → 0。
TRUSTED_PROXY_HOPS=1
# 全局同时运行的 Beagle 填充进程上限（每个占数 GB 内存）
IMPUTATION_MAX_CONCURRENT=2
# Agent 对话上下文（默认 128K token 估算上限；DeepSeek 等长上下文模型可酌情调大）
# AGENT_MEMORY_MAX_TOKENS=128000
# AGENT_MEMORY_PRESERVE_MIN_MESSAGES=8
# AGENT_TOOL_RESULT_MAX_CHARS=32000
# AGENT_TOOL_RESULT_GWAS_MAX_CHARS=48000
# 空结果硬拦截：数据工具全空时强制「未找到记录」，禁止模型续写
# EMPTY_RESULT_HARD_BLOCK=true
# 会话历史落 SQLite（重启可恢复）；不存 API Key
# SESSION_PERSISTENCE_ENABLED=true
# SESSION_DB_PATH=./data/sessions.db
# SESSION_TTL_DAYS=7
AUTH_USERS_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string

# ---------- ⑤ Beagle / 生信（bcftools 由 setup-env.sh 装入 gaoai/bin）----------
# Beagle JAR 路径：留空则自动查找 refpanel/beagle.jar
#BEAGLE_JAR_PATH=/home/you/ChickenSVA/refpanel/beagle.jar

# ---------- ⑥ 数据路径（与 CHICKENSV_ROOT 一致时可省略，代码自动推断）----------
# CSV_DATA_PATH=
# REFPANEL_PATH=
# WORKSPACE_BASE_PATH=
